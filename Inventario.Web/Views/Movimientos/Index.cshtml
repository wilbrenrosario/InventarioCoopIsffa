@model List<Inventario.Application.DTOs.MovimientoDto>
@{
    ViewData["Title"] = "Historial de Movimientos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Historial de Movimientos</h1>
        <p class="text-muted mb-0">Listado de todas las entradas y salidas de inventario</p>
    </div>
    <a asp-action="Registrar" class="btn btn-success d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Registrar Movimiento
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3">Fecha</th>
                        <th class="px-4 py-3">Producto</th>
                        <th class="px-4 py-3">Tipo</th>
                        <th class="px-4 py-3 text-end">Cantidad</th>
                        <th class="px-4 py-3">Comentario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-clipboard-x display-5 d-block mb-2"></i>
                                No hay movimientos registrados.
                            </td>
                        </tr>
                    }
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="px-4 text-muted">@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-4 fw-medium text-dark">@m.ProductoNombre</td>
                            <td class="px-4">
                                @if (m.Tipo == "Entrada")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3"><i class="bi bi-arrow-down-left me-1"></i>Entrada</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3"><i class="bi bi-arrow-up-right me-1"></i>Salida</span>
                                }
                            </td>
                            <td class="px-4 text-end fw-bold @(m.Tipo == "Entrada" ? "text-success" : "text-danger")">
                                @(m.Tipo == "Entrada" ? "+" : "-")@m.Cantidad
                            </td>
                            <td class="px-4 text-muted small">@m.Comentario</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
