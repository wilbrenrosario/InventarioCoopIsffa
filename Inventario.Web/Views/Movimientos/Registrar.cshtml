@model Inventario.Application.Movimientos.Commands.RegistrarMovimientoCommand
@{
    ViewData["Title"] = "Registrar Movimiento";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <a asp-action="Index" asp-controller="Productos" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> Volver al catálogo
            </a>
            <h1 class="fw-bold">Registrar Movimiento de Stock</h1>
            <p class="text-muted">Registra una entrada o salida de stock para un producto.</p>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Registrar" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 rounded-3 mb-4" role="alert">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i>
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="ProductoId" class="form-label fw-semibold">Producto</label>
                            <select asp-for="ProductoId" asp-items="ViewBag.ProductoId" class="form-select form-select-lg">
                                <option value="">-- Selecciona el producto --</option>
                            </select>
                            <span asp-validation-for="ProductoId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Tipo" class="form-label fw-semibold">Tipo de Movimiento</label>
                            <div class="d-flex gap-3">
                                <div class="flex-fill">
                                    <input type="radio" class="btn-check" asp-for="Tipo" id="tipoEntrada" value="1" />
                                    <label class="btn btn-outline-success w-100 py-3" for="tipoEntrada">
                                        <i class="bi bi-arrow-down-circle fs-4 d-block mb-1"></i>
                                        Entrada
                                    </label>
                                </div>
                                <div class="flex-fill">
                                    <input type="radio" class="btn-check" asp-for="Tipo" id="tipoSalida" value="2" />
                                    <label class="btn btn-outline-danger w-100 py-3" for="tipoSalida">
                                        <i class="bi bi-arrow-up-circle fs-4 d-block mb-1"></i>
                                        Salida
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Tipo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cantidad" class="form-label fw-semibold">Cantidad</label>
                            <input asp-for="Cantidad" type="number" min="1" class="form-control form-control-lg" placeholder="0" />
                            <span asp-validation-for="Cantidad" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Comentario" class="form-label fw-semibold">
                                Comentario <span class="text-muted fw-normal">(opcional)</span>
                            </label>
                            <textarea asp-for="Comentario" class="form-control" rows="3" placeholder="Ej: Recepción de compra, pedido #123..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                        <a asp-action="Index" asp-controller="Productos" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle me-2"></i>Confirmar Movimiento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
