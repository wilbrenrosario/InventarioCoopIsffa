@model Inventario.Application.Productos.Commands.CrearProductoCommand
@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> Volver al catálogo
            </a>
            <h1 class="fw-bold">Registrar Producto</h1>
            <p class="text-muted">Completa los datos del nuevo producto para el inventario.</p>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-4" role="alert"></div>

                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label fw-semibold">Nombre del Producto</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Taladro Percutor 700W" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Sku" class="form-label fw-semibold">SKU</label>
                            <input asp-for="Sku" class="form-control" placeholder="Ej: TLR-001" />
                            <span asp-validation-for="Sku" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-semibold">Categoría</label>
                            <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select">
                                <option value="">-- Selecciona una categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label fw-semibold">Precio Unitario (₡)</label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2 me-2"></i>Guardar Producto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
