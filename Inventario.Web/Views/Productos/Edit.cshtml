@model Inventario.Application.Productos.Commands.ActualizarProductoCommand
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="fw-bold mb-0">Editar Producto</h1>
    </div>
    <p class="text-muted ms-5">Modifica los detalles del producto seleccionado</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label fw-medium">Nombre del Producto</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Jabón Líquido" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Sku" class="form-label fw-medium">SKU (Código)</label>
                            <input asp-for="Sku" class="form-control" placeholder="Ej: JB-001" />
                            <span asp-validation-for="Sku" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="CategoriaId" class="form-label fw-medium">Categoría</label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                <option value="">-- Seleccionar --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Precio" class="form-label fw-medium">Precio (₡)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₡</span>
                                <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium d-block">Estado</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="Activo" role="switch" id="activoSwitch">
                                <label class="form-check-label text-muted" for="activoSwitch">Producto Activo</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">
                    
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
