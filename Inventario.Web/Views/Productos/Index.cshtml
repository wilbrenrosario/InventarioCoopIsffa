@model List<Inventario.Application.DTOs.ProductoDto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Catálogo de Productos</h1>
        <p class="text-muted mb-0">Gestiona el inventario de productos activos</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Nuevo Producto
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3">SKU</th>
                        <th class="px-4 py-3">Nombre</th>
                        <th class="px-4 py-3">Categoría</th>
                        <th class="px-4 py-3">Precio</th>
                        <th class="px-4 py-3">Stock Actual</th>
                        <th class="px-4 py-3">Estado</th>
                        <th class="px-4 py-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-5 d-block mb-2"></i>
                                No hay productos registrados.
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="px-4"><code class="text-primary">@p.Sku</code></td>
                            <td class="px-4 fw-medium">@p.Nombre</td>
                            <td class="px-4">
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">@p.CategoriaNombre</span>
                            </td>
                            <td class="px-4">₡@p.Precio.ToString("N2")</td>
                            <td class="px-4">
                                @if (p.StockActual == 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger badge-stock"><i class="bi bi-exclamation-triangle me-1"></i>@p.StockActual</span>
                                }
                                else if (p.StockActual < 10)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning badge-stock"><i class="bi bi-exclamation-circle me-1"></i>@p.StockActual</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success badge-stock"><i class="bi bi-check-circle me-1"></i>@p.StockActual</span>
                                }
                            </td>
                            <td class="px-4">
                                @if (p.Activo)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Inactivo</span>
                                }
                            </td>
                            <td class="px-4 text-end">
                                <a asp-action="Registrar" asp-controller="Movimientos" asp-route-productoId="@p.Id"
                                   class="btn btn-sm btn-outline-success me-1" title="Registrar Movimiento">
                                    <i class="bi bi-arrow-left-right"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
