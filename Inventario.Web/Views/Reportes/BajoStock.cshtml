@model List<Inventario.Application.DTOs.ProductoBajoStockDto>
@{
    ViewData["Title"] = "Productos con Bajo Stock";
    int umbral = ViewBag.Umbral ?? 10;
    var labels = Model.Select(p => p.Nombre).ToArray();
    var values = Model.Select(p => p.StockActual).ToArray();
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="fw-bold mb-1">Productos con Bajo Stock</h1>
        <p class="text-muted">Productos cuyo stock actual es menor o igual al umbral configurado.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportarBajoStockCsv" asp-route-umbral="@umbral" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar CSV
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="BajoStock" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Umbral de Stock</label>
                <input type="number" name="umbral" value="@umbral" min="0" class="form-control" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-2"></i>Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card h-100 border-warning">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                <i class="bi bi-exclamation-triangle-fill text-warning display-3 mb-3"></i>
                <p class="text-muted mb-1">Productos Bajo Stock</p>
                <h2 class="fw-bold text-warning mb-0">@Model.Count</h2>
                <small class="text-muted">con umbral ≤ @umbral unidades</small>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-bar-chart me-2"></i>Stock Actual por Producto
            </div>
            <div class="card-body" style="height: 260px;">
                @if (Model.Any())
                {
                    <canvas id="bajoStockChart"></canvas>
                }
                else
                {
                    <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                        <div class="text-center">
                            <i class="bi bi-check-circle-fill text-success display-4 mb-2"></i>
                            <p>¡Todos los productos tienen stock suficiente!</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">
        <i class="bi bi-table me-2"></i>Detalle de Productos
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3">SKU</th>
                        <th class="px-4 py-3">Producto</th>
                        <th class="px-4 py-3">Categoría</th>
                        <th class="px-4 py-3 text-center">Stock Actual</th>
                        <th class="px-4 py-3 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="px-4"><code class="text-primary">@p.Sku</code></td>
                            <td class="px-4 fw-medium">@p.Nombre</td>
                            <td class="px-4 text-muted">@p.CategoriaNombre</td>
                            <td class="px-4 text-center">
                                <span class="badge @(p.StockActual == 0 ? "bg-danger" : "bg-warning text-dark") fs-6 px-3">
                                    @p.StockActual
                                </span>
                            </td>
                            <td class="px-4 text-center">
                                @if (p.StockActual == 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Sin Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Bajo Stock</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                No hay productos con stock por debajo del umbral (@umbral).
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Any())
    {
        <script>
            const ctx = document.getElementById('bajoStockChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
                    datasets: [{
                        label: 'Stock Actual',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(values)),
                        backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(values.Select(v => v == 0 ? "rgba(220,53,69,0.8)" : "rgba(255,193,7,0.8)").ToArray())),
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        annotation: {
                            annotations: {
                                umbralLine: {
                                    type: 'line',
                                    yMin: @umbral,
                                    yMax: @umbral,
                                    borderColor: 'rgba(220,53,69,0.8)',
                                    borderWidth: 2,
                                    borderDash: [6, 4],
                                    label: { content: 'Umbral', enabled: true }
                                }
                            }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        </script>
    }
}
