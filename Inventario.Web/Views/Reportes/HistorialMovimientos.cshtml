@model List<Inventario.Application.DTOs.MovimientoHistorialDto>
@using Inventario.Application.DTOs
@{
    ViewData["Title"] = "Historial de Movimientos";
    List<ProductoDto> productos = ViewBag.Productos ?? new List<ProductoDto>();
    int? productoId = ViewBag.ProductoId;
    string fechaInicio = ViewBag.FechaInicio ?? DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");
    string fechaFin = ViewBag.FechaFin ?? DateTime.Now.ToString("yyyy-MM-dd");

    var entradas = Model.Count(m => m.Tipo == "Entrada");
    var salidas = Model.Count(m => m.Tipo == "Salida");
    var totalEntradas = Model.Where(m => m.Tipo == "Entrada").Sum(m => m.Cantidad);
    var totalSalidas = Model.Where(m => m.Tipo == "Salida").Sum(m => m.Cantidad);

    var labels = Model.GroupBy(m => m.Fecha.ToString("dd/MM"))
                      .Select(g => g.Key).ToArray();
    var entradasPorDia = Model.GroupBy(m => m.Fecha.ToString("dd/MM"))
                              .Select(g => g.Where(m => m.Tipo == "Entrada").Sum(m => m.Cantidad)).ToArray();
    var salidasPorDia = Model.GroupBy(m => m.Fecha.ToString("dd/MM"))
                             .Select(g => g.Where(m => m.Tipo == "Salida").Sum(m => m.Cantidad)).ToArray();
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Historial de Movimientos</h1>
    <p class="text-muted">Movimientos de stock de productos en un rango de fechas.</p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="HistorialMovimientos" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Producto</label>
                <select name="productoId" class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var p in productos)
                    {
                        <option value="@p.Id" selected="@(productoId == p.Id)">@p.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Fecha Inicio</label>
                <input type="date" name="fechaInicio" value="@fechaInicio" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Fecha Fin</label>
                <input type="date" name="fechaFin" value="@fechaFin" class="form-control" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-2"></i>Buscar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body py-4">
                <i class="bi bi-arrow-down-circle-fill text-success display-5 mb-2"></i>
                <p class="text-muted mb-1 small">Total Entradas</p>
                <h3 class="fw-bold text-success mb-0">@totalEntradas</h3>
                <small class="text-muted">@entradas movimientos</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body py-4">
                <i class="bi bi-arrow-up-circle-fill text-danger display-5 mb-2"></i>
                <p class="text-muted mb-1 small">Total Salidas</p>
                <h3 class="fw-bold text-danger mb-0">@totalSalidas</h3>
                <small class="text-muted">@salidas movimientos</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold border-0">
                <i class="bi bi-graph-up me-2"></i>Movimientos por Día
            </div>
            <div class="card-body" style="height: 180px;">
                @if (Model.Any())
                {
                    <canvas id="historialChart"></canvas>
                }
                else
                {
                    <div class="d-flex h-100 align-items-center justify-content-center text-muted">
                        Sin movimientos en el período.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">
        <i class="bi bi-list-ul me-2"></i>Detalle de Movimientos
        <span class="badge bg-primary ms-2">@Model.Count registros</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3">Fecha</th>
                        <th class="px-4 py-3">Producto</th>
                        <th class="px-4 py-3 text-center">Tipo</th>
                        <th class="px-4 py-3 text-center">Cantidad</th>
                        <th class="px-4 py-3">Comentario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="px-4 text-muted small">@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-4 fw-medium">@m.ProductoNombre</td>
                            <td class="px-4 text-center">
                                @if (m.Tipo == "Entrada")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                        <i class="bi bi-arrow-down me-1"></i>Entrada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">
                                        <i class="bi bi-arrow-up me-1"></i>Salida
                                    </span>
                                }
                            </td>
                            <td class="px-4 text-center fw-bold">@m.Cantidad</td>
                            <td class="px-4 text-muted">@(string.IsNullOrEmpty(m.Comentario) ? "—" : m.Comentario)</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No se encontraron movimientos en el período seleccionado.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Any())
    {
        <script>
            const ctx = document.getElementById('historialChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
                    datasets: [
                        {
                            label: 'Entradas',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(entradasPorDia)),
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16,185,129,0.1)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4
                        },
                        {
                            label: 'Salidas',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(salidasPorDia)),
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239,68,68,0.1)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { font: { family: 'Inter', size: 12 }, usePointStyle: true }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        </script>
    }
}
