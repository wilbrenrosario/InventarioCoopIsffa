@model List<Inventario.Application.DTOs.ReporteValorizacionDto>
@{
    ViewData["Title"] = "Reportes de Valorización";
    var labels = Model.Select(r => r.CategoriaNombre).ToArray();
    var values = Model.Select(r => r.ValorTotal).ToArray();
    var total = Model.Sum(r => r.ValorTotal);
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Reportes</h1>
    <p class="text-muted">Análisis y estadísticas del inventario.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-primary">
            <i class="bi bi-graph-up-arrow me-2"></i>Valorización
        </a>
    </div>
    <div class="col-auto">
        <a asp-action="BajoStock" class="btn btn-outline-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Bajo Stock
        </a>
    </div>
    <div class="col-auto">
        <a asp-action="HistorialMovimientos" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history me-2"></i>Historial de Movimientos
        </a>
    </div>
</div>

<hr class="mb-4">

<div class="mb-3">
    <h5 class="fw-semibold text-muted">Valorización de Inventario por Categoría</h5>
    <p class="text-muted small">Valor total del inventario segmentado por categoría (Σ Precio × StockActual).</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                <i class="bi bi-graph-up-arrow text-primary display-3 mb-3"></i>
                <p class="text-muted mb-1">Valor Total Inventario</p>
                <h2 class="fw-bold text-primary mb-0">₡@total.ToString("N2")</h2>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-pie-chart me-2"></i>Distribución por Categoría
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="height: 260px;">
                <canvas id="valorizacionChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
        <span><i class="bi bi-table me-2"></i>Detalle por Categoría</span>
        <a asp-action="ExportarCsv" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar CSV
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3">Categoría</th>
                    <th class="px-4 py-3">Productos</th>
                    <th class="px-4 py-3 text-end">Valor Total</th>
                    <th class="px-4 py-3 text-end">% del Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.OrderByDescending(x => x.ValorTotal))
                {
                    var porcentaje = total > 0 ? (r.ValorTotal / total) * 100 : 0;
                    <tr>
                        <td class="px-4 fw-medium">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill me-2">@r.CategoriaNombre</span>
                        </td>
                        <td class="px-4 text-muted">@r.CantidadProductos productos</td>
                        <td class="px-4 text-end fw-semibold text-primary">₡@r.ValorTotal.ToString("N2")</td>
                        <td class="px-4 text-end">
                            <div class="d-flex align-items-center justify-content-end gap-2">
                                <div class="progress flex-grow-1" style="height: 8px; max-width: 100px;">
                                    <div class="progress-bar bg-primary" role="progressbar"
                                         style="width: @porcentaje.ToString("F0")%">
                                    </div>
                                </div>
                                <span class="text-muted small">@porcentaje.ToString("F1")%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    const ctx = document.getElementById('valorizacionChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(values)),
                backgroundColor: ['#2563eb', '#38bdf8', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6'],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'right',
                    labels: { font: { family: 'Inter', size: 13 }, usePointStyle: true, padding: 20 }
                },
                tooltip: {
                    callbacks: {
                        label: function(ctx) {
                            return ' ₡' + ctx.parsed.toLocaleString('es-CR', {minimumFractionDigits: 2});
                        }
                    }
                }
            }
        }
    });
</script>
}
